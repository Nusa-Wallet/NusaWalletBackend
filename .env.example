# Copy to .env and adjust. For hackathon dev, SQLite default works out of the box.
APP_ENV=development
DATABASE_URL=sqlite:///./nusawallet.db
# For Postgres (docker-compose): postgresql+psycopg2://nusa:nusa@localhost:5432/nusawallet
JWT_SECRET=change-this-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# URL of the separate AI service (NusaWalletAI)
AI_SERVICE_URL=http://localhost:8001
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000
# Development convenience only. Set false in production and run migrations instead.
AUTO_CREATE_TABLES=true
